# GENERATED by gen_policy.py from tf_risk_scan.CRITICAL_TYPES. Do not edit by hand.
# Blocks any plan that destroys or replaces a critical (stateful / outage-causing) resource.
# Evaluated inside HCP Terraform: no inbound connectivity to your network needed.
package terraform.policies.block_destructive

import rego.v1

critical_patterns := [
	"databricks_mws_workspaces",
	"databricks_workspace*",
	"databricks_metastore*",
	"databricks_catalog",
	"databricks_schema",
	"databricks_external_location",
	"databricks_storage_credential",
	"databricks_cluster",
	"databricks_instance_pool",
	"databricks_sql_endpoint",
	"databricks_job",
	"databricks_mws_networks",
	"databricks_mws_private_access_settings",
	"azurerm_databricks_workspace*",
	"aws_db_instance",
	"aws_rds_cluster*",
	"aws_dynamodb_table",
	"aws_elasticache_*",
	"aws_redshift_cluster",
	"azurerm_mssql_*",
	"azurerm_postgresql*",
	"azurerm_mysql*",
	"azurerm_cosmosdb_*",
	"google_sql_database*",
	"google_bigquery_dataset",
	"snowflake_database",
	"snowflake_schema",
	"aws_s3_bucket",
	"aws_efs_file_system",
	"aws_kms_key",
	"azurerm_storage_account",
	"azurerm_storage_container",
	"azurerm_key_vault*",
	"google_storage_bucket",
	"google_kms_*",
	"aws_vpc",
	"aws_subnet",
	"aws_nat_gateway",
	"aws_vpc_endpoint",
	"aws_route_table",
	"azurerm_virtual_network",
	"azurerm_subnet",
	"azurerm_private_endpoint",
	"azurerm_network_security_group",
	"google_compute_network",
	"google_compute_subnetwork"
]

is_critical(rtype) if {
	some p in critical_patterns
	glob.match(p, [], rtype)
}

action_name(actions) := "REPLACE" if {
	"delete" in actions
	"create" in actions
} else := "DESTROY"

deny contains msg if {
	some rc in input.plan.resource_changes
	rc.mode == "managed"
	"delete" in rc.change.actions
	is_critical(rc.type)
	msg := sprintf(
		"%s of critical resource %s (reason: %s). See the tf-risk-agent comment on this run; override only if intentional.",
		[action_name(rc.change.actions), rc.address, object.get(rc, "action_reason", "not reported")],
	)
}
